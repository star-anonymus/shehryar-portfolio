# Public URL of the deployed site, no trailing slash.
# Drives metadataBase, the sitemap, every OG image and every LinkedIn share link.
# Leave it unset on Vercel and it falls back to the project's production URL.
NEXT_PUBLIC_SITE_URL=

# Claude API key — powers the Content Studio (trend research + post drafting).
# Get one at https://console.anthropic.com
ANTHROPIC_API_KEY=

# Shared secret that gates /api/studio/generate. Any long random string.
# The same value goes into the GitHub repo secret STUDIO_TOKEN.
# If this is unset the generate endpoint refuses every request.
STUDIO_TOKEN=

# Optional: raises the GitHub API rate limit from 60/hr to 5000/hr.
# A fine-grained token with public read access is enough.
GITHUB_TOKEN=
